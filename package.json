{
  "name": "atlas-invoice",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "nx run invoicing:dev",
    "dev:procurement": "nx run procurement:dev",
    "build": "nx run-many -t build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:regression": "playwright test --config=playwright.apply-rollback.config.ts tests/e2e/apply-rollback-disposable.spec.ts && playwright test --config=playwright.phase5.config.ts tests/e2e/phase5-progress.spec.ts && playwright test --config=playwright.manual-regression.config.ts tests/e2e/security-negative.spec.ts tests/e2e/restart-infrastructure.spec.ts tests/e2e/stale-lifecycle.spec.ts tests/e2e/failed-lifecycle.spec.ts",
    "rtl:e2e:build": "node scripts/build-e2e-dist.mjs",
    "pretest:e2e:regression": "node scripts/build-e2e-dist.mjs && node scripts/verify-e2e-dist.mjs",
    "test:visual": "playwright test --grep visual",
    "storybook": "storybook dev -p 6006",
    "rtl:scan": "node packages/rtl-analyzer/dist/cli.js",
    "rtl:scan:test": "npm --prefix implementation run rtl:scan:test",
    "rtl:overlay:test": "tsc -p tools/rtl-scanner/tsconfig.json && vitest run --config tools/rtl-scanner/vitest.config.ts",
    "rtl:scan:typecheck": "npm --prefix implementation run rtl:scan:typecheck",
    "rtl:scan:build": "npm run build --prefix packages/rtl-analyzer",
    "rtl:cli:package:smoke": "node scripts/consumer-smoke.mjs",
    "rtl:preview": "node packages/rtl-analyzer/dist/preview-cli.js"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.0",
    "@mui/material": "^7.3.0",
    "@mui/stylis-plugin-rtl": "7.3.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "stylis": "4.2.0"
  },
  "devDependencies": {
    "@nx/vite": "23.3.0",
    "@playwright/test": "1.64.0",
    "@storybook/react-vite": "10.6.7",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/stylis": "4.2.7",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9.0.0",
    "jsdom": "^26.0.0",
    "nx": "23.3.0",
    "parse5": "7.3.0",
    "postcss": "8.5.29",
    "postcss-scss": "4.0.9",
    "postcss-value-parser": "4.2.0",
    "storybook": "10.6.7",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.4.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "5.0.3"
  },
  "overrides": {
    "undici": "^7.30.1"
  },
  "type": "module"
}
